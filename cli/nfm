#!/bin/bash
# NFM-X CLI Entry Point
# This script serves as the main executable for the NFM-X command line interface

PYTHON_PATH="python3"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Check if Python is available
if ! command -v "$PYTHON_PATH" &> /dev/null; then
    echo "Error: Python3 is not installed. Please install Python 3.8+ to run NFM-X CLI."
    exit 1
fi

# Run the main CLI Python script
exec "$PYTHON_PATH" "$SCRIPT_DIR/main.py" "$@"