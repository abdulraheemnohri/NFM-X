## NFM-X Configuration
# Copy this file to .env and modify as needed

## Application
APP_NAME=NFM-X
APP_VERSION=4.0.0
DEBUG=false
ENVIRONMENT=development

## Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

## Database
DATABASE_URL=sqlite+aiosqlite:///./data/nfm-x.db
NFM_DB_PATH=./data/nfm-x.db

## CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8765,http://127.0.0.1:3000

## Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

## FAISS Index
FAISS_INDEX_PATH=./storage/vectors
NFM_VECTOR_PATH=./storage/vectors

## Background Jobs
BACKGROUND_WORKER_ENABLED=true
CONSOLIDATION_INTERVAL_HOURS=24

## Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/nfm-x.log
LOG_FILE_ENABLED=false
LOG_CONSOLE_ENABLED=true

## Security
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY=your-api-key-here

## Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_REQUESTS=10
RATE_LIMIT_WHITELIST=

## Storage
STORAGE_DIR=./storage
VECTOR_STORE_DIR=./storage/vectors
UPLOAD_DIR=./uploads
STORAGE_PATH=./storage
BACKUP_PATH=./backups
MAX_MEMORY_SIZE_MB=100

## Model Settings
MAX_CONTEXT_LENGTH=4096
TEMPERATURE=0.7
TOP_K=5

## Network
TIMEOUT=30
RETRY_COUNT=3

## OCR Configuration
OCR_ENABLED=true
OCR_ENGINE=easyocr
OCR_LANGUAGES=en
OCR_TABLE_EXTRACTION=false
OCR_EASYOCR_MODEL=en
OCR_TESSERACT_PATH=
OCR_CLOUD_PROVIDER=
OCR_CLOUD_API_KEY=

## Compression Configuration
COMPRESSION_ENABLED=true
COMPRESSION_AGE_DAYS=30
COMPRESSION_IMPORTANCE_THRESHOLD=0.5
COMPRESSION_RUN_INTERVAL_HOURS=24
COMPRESSION_MAX_PER_RUN=100
COMPRESSION_ARCHIVE_ENABLED=true
COMPRESSION_ARCHIVE_AGE_DAYS=90

## Sync Configuration
SYNC_ENABLED=true
SYNC_CONFLICT_STRATEGY=timestamp
SYNC_AUTO_RESOLVE=true
SYNC_INTERVAL_SECONDS=60
SYNC_MAX_RETRIES=3

## MCP Server Configuration
MCP_ENABLED=false
MCP_HOST=localhost
MCP_PORT=8765
MCP_API_KEY=
MCP_REQUIRE_AUTH=false

## Upload Configuration
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.txt,.json,.zip,.tar,.tar.gz
UPLOAD_BATCH_ENABLED=true
UPLOAD_MAX_BATCH_SIZE=10

## Health Check Configuration
HEALTH_CHECK_DB=true
HEALTH_CHECK_VECTOR_STORE=true
HEALTH_CHECK_OCR=true
HEALTH_CHECK_STORAGE=true
HEALTH_CHECK_TIMEOUT_SECONDS=5