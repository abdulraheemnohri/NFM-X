# NFM-X Configuration
# Copy this file to .env and modify as needed

# Server settings
NFM_HOST=0.0.0.0
NFM_PORT=8765
NFM_DEBUG=true
NFM_LOG_LEVEL=INFO

# Storage settings
NFM_STORAGE_PATH=./storage
NFM_VECTOR_BACKEND=faiss
NFM_EMBEDDING_MODEL=all-MiniLM-L6-v2
NFM_EMBEDDING_DIM=384

# Database settings
NFM_DB_PATH=./storage/nfm.db
NFM_DB_POOL_SIZE=5
NFM_DB_MAX_OVERFLOW=10

# AI Provider settings (optional)
NFM_LLM_PROVIDER=ollama
NFM_LLM_MODEL=llama3.2
NFM_LLM_BASE_URL=http://localhost:11434
NFM_LLM_API_KEY=
NFM_LLM_TIMEOUT=120
NFM_LLM_MAX_TOKENS=4096
NFM_LLM_TEMPERATURE=0.7

# Memory settings
NFM_MAX_CONTEXT_MEMORIES=20
NFM_MIN_CONFIDENCE=0.3
NFM_DEFAULT_CONFIDENCE=0.7
NFM_MEMORY_EXPIRY_DAYS=30

# Security settings
NFM_API_TOKEN=
NFM_ENABLE_AUTH=false
NFM_ENCRYPTION_KEY=

# Background workers
NFM_WORKER_COUNT=4
NFM_CONSOLIDATION_INTERVAL=3600
NFM_BACKUP_INTERVAL=86400

# Retrieval settings
NFM_SEMANTIC_WEIGHT=0.6
NFM_KEYWORD_WEIGHT=0.2
NFM_GRAPH_WEIGHT=0.15
NFM_TEMPORAL_WEIGHT=0.05