# NFM-X Configuration
# Copy this file to .env and modify as needed

# Application
APP_NAME=NFM-X
APP_VERSION=1.5.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database
# SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///./nfm.db

# PostgreSQL (alternative)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nfm_x

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# FAISS Index
FAISS_INDEX_PATH=./faiss_index

# Memory
MAX_MEMORY_SIZE=1000000
MEMORY_BATCH_SIZE=100

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Background Jobs
CONSOLIDATION_INTERVAL=1

# File paths
DATA_DIR=./data
BACKUP_DIR=./backups

# Security
SECRET_KEY=change-me-in-production-to-a-strong-random-key